# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN='replace-with-botfather-token'

# Optional: set these if you do not want the bot to auto-detect chat_id from /start.
# CLAUDE_STATUS_CHAT_ID='123456789'
# CLAUDE_STATUS_MESSAGE_ID='4'

# Optional paths.
# CLAUDE_BIN='/Users/you/.local/bin/claude'
# CLAUDE_CREDENTIALS_FILE='/Users/you/.claude/.credentials.json'

# Optional: OpenAI Codex subscription usage + pay-as-you-go API billing section.
# Codex usage requires the CodexBar CLI (https://codexbar.app) to be installed
# and logged in; skipped silently if codexbar is not on PATH.
# Billing requires an Admin API key (not a regular sk-proj- key) from
# platform.openai.com -> Settings -> Organization -> Admin keys, scoped to
# api.usage.read only.
# OPENAI_ADMIN_KEY='sk-admin-...'
