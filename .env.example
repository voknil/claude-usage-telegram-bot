# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN='replace-with-botfather-token'

# Optional: set these if you do not want the bot to auto-detect chat_id from /start.
# CLAUDE_STATUS_CHAT_ID='123456789'
# CLAUDE_STATUS_MESSAGE_ID='4'

# Optional paths.
